# Nostr Wallet Connect Configuration
# Get this from your Alby Hub at https://getalby.com
# Go to Connections → Apps → Connect a new app
# Enable ALL permissions: make_invoice, lookup_invoice, send_payment, get_balance, get_info
# Copy the connection string and paste it below

APP_NWC_STRING=nostr+walletconnect://YOUR_PUBKEY?relay=wss://relay.getalby.com/v1&secret=YOUR_SECRET

# Optional: verify Alby webhooks
ALBY_WEBHOOK_SECRET=YOUR_ALBY_WEBHOOK_SECRET

# Example:
# APP_NWC_STRING=nostr+walletconnect://abc123...?relay=wss://relay.getalby.com/v1&secret=def456...
